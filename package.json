{
	"name": "kudos-donations",
	"version": "4.3.0",
	"private": true,
	"description": " Add a donation button to any page on your website. Easy & fast setup. Works with Mollie payments.",
	"author": "Michael Iseard",
	"keywords": [
		"donation",
		"mollie",
		"wordpress"
	],
	"homepage": "https://kudosdonations.com",
	"repository": "https://github.com/mikey242/kudos-donations",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"bugs": {
		"url": "https://github.com/mikey242/kudos-donations/issues",
		"email": "michael@iseard.media"
	},
	"dependencies": {
		"@headlessui/react": "2.2.10",
		"@heroicons/react": "^2.2.0",
		"clsx": "^2.1.1",
		"nuqs": "^2.4.3",
		"react-hook-form": "^7.59.0",
		"react-shadow": "^20.6.0"
	},
	"devDependencies": {
		"@tailwindcss/forms": "^0.5.10",
		"@types/codemirror": "^5.60.15",
		"@types/lodash": "^4.17.16",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/babel-preset-default": "^10.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/browserslist-config": "^7.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/date": "^6.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^7.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/eslint-plugin": "^28.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/stylelint-config": "^27.0.0",
		"@wordpress/theme": "^3.0.0",
		"@wordpress/url": "^5.0.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^10.4.1",
		"eslint-import-resolver-typescript": "^4.4.4",
		"lodash": "^4.17.21",
		"postcss": "^8.5.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"stylelint": "^17.15.0",
		"stylelint-config-tailwindcss": "^1.0.1",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.9.3",
		"webpack-cli": "^7.0.0",
		"webpack-dev-server": "^6.0.0",
		"webpack-merge": "^6.0.1"
	},
	"scripts": {
		"build": "npm run build:admin && npm run build:front",
		"build:admin": "wp-scripts build --config src/admin/webpack.config.admin.js --webpack-src-dir=src/admin --output-path=build/admin",
		"build:front": "wp-scripts build --config src/block/webpack.config.front.js --output-path=build/front",
		"check-engines": "wp-scripts check-engines",
		"start:admin": "wp-scripts start --hot --config src/admin/webpack.config.admin.js --webpack-src-dir=src/admin --output-path=build/admin",
		"start:front": "wp-scripts start --hot --config src/block/webpack.config.front.js --output-path=build/front",
		"make-pot": "wp i18n make-pot . --exclude='src, wordpress, config, assets, tests' --debug",
		"make-json": "wp i18n make-json languages/ --no-purge",
		"start:tunnel": "cloudflared tunnel --config cloudflared.dev.yml run",
		"log:follow": "ddev exec tail -f /var/www/html/wordpress/wp-content/debug.log",
		"log:clear": "ddev exec truncate -s 0 /var/www/html/wordpress/wp-content/debug.log",
		"test:unit": "ddev phpunit --testsuite unit",
		"test:integration": "ddev phpunit --testsuite integration",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style 'src/**/*.css'",
		"lint:js": "wp-scripts lint-js ./src",
		"packages-update": "wp-scripts packages-update",
		"fixtures": "ddev wp kudos:fixtures:all --delete --force --count-campaign=20 --count-donor=50 --count-transaction=200 --count-subscription=10",
		"make-zip": "rm -f kudos-donations.zip && php wp-cli.phar dist-archive . ./kudos-donations.zip --allow-root"
	},
	"overrides": {
		"@types/react": "$@types/react",
		"@types/react-dom": "$@types/react-dom"
	}
}
