includes:
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
  level: 5
  inferPrivatePropertyTypeFromConstructor: true

  paths:
    - kudos-donations.php
    - uninstall.php
    - config
    - includes

  excludePaths:
    # php-scoper configuration; runs under php-scoper's own autoloader, not the plugin's.
    - config/php-scoper

  # Defined from the environment at runtime, so their value is not fixed.
  dynamicConstantNames:
    - KUDOS_DEMO_MODE
    - KUDOS_ENV_IS_DEVELOPMENT

  scanDirectories:
    - third-party/

  scanFiles:
    - vendor/woocommerce/action-scheduler/functions.php
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
    - vendor/php-stubs/wordpress-tests-stubs/wordpress-tests-stubs.php
    - kudos-donations.php
    - phpstan-stubs.php

  ignoreErrors:
    # The WordPress stubs say registered settings always have a 'default', but
    # register_setting() only stores it when one is passed (wp-includes/option.php).
    -
      identifier: nullCoalesce.unnecessary
      path: includes/Service/SettingsService.php

  bootstrapFiles:
    - phpstan-bootstrap.php
